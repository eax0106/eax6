# Operator-supplied settings for the EC2 host. Copy to operator.env next to this
# file on the host and fill every value. References name secrets in AWS Secrets
# Manager; no secret value belongs in this file.

# Public name the TLS certificate is issued for. Its A record must point at the
# instance's Elastic IP (terraform output public_ip) before bootstrap runs.
ALTER_DOMAIN=<app.example.com>

# Images: the registry and tag CI publishes (docker/README.md).
ALTER_REGISTRY=ghcr.io/havishalterx-eng/alter
ALTER_IMAGE_TAG=main

# Auth0 -- real sign-in and service-to-service tokens (replaces the local mock
# issuer). Create the tenant, an API with this audience, and an M2M application.
AUTH0_DOMAIN=<tenant.region.auth0.com>
AUTH0_API_AUDIENCE=<https://engine.alter.example>
AUTH0_M2M_CLIENT_ID=<m2m-client-id>
AUTH0_M2M_CLIENT_SECRET_REF=<secret name holding the M2M client secret>
# The customer application people sign in to (platform-api's identity provider):
# a regular web application; its client secret goes in Secrets Manager.
AUTH0_CLIENT_ID=<customer application client id>
AUTH0_CLIENT_SECRET_REF=<secret name holding the customer application's client secret>

# Email (task 6.1d): SES, which the services require in production. Verify the
# sending domain in SES (and leave the SES sandbox) first. The secret holds
# {"accessKeyId": "...", "secretAccessKey": "..."} for an IAM user allowed
# ses:SendEmail / ses:SendTemplatedEmail.
SES_FROM_ADDRESS=<no-reply@example.com>
SES_CREDENTIALS_SECRET_REF=<secret name holding the SES access key JSON>
# Terraform supplies the environment's SES configuration set through SSM.
# bootstrap.sh generates the webhook key and binds the EventBridge route.

# Temporal Cloud (task 6.2). Namespace address and name from the Temporal Cloud
# console; the API key goes in Secrets Manager.
TEMPORAL_ADDRESS=<namespace.account.tmprl.cloud:7233>
TEMPORAL_NAMESPACE=<namespace.account>
TEMPORAL_API_KEY_SECRET_REF=<secret name holding the Temporal Cloud API key>
TEMPORAL_WORKER_DEPLOYMENT_NAME=alter-engine
TEMPORAL_MINIMUM_RETENTION_DAYS=7

# Staff sign-in for the admin console (task B1.0): the dedicated staff Auth0
# tenant and its PKCE application. Not secret.
AUTH0_STAFF_DOMAIN=<staff-tenant.region.auth0.com>
AUTH0_STAFF_CLIENT_ID=<staff SPA client id>
