{
  "name": "public-surface",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/public-surface/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/public-surface"
      ],
      "options": {
        "command": "tsc -p apps/public-surface/tsconfig.app.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "tsc --noEmit -p apps/public-surface/tsconfig.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "eslintConfig": "apps/public-surface/eslint.config.mjs",
        "lintFilePatterns": [
          "apps/public-surface/src/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "vitest run apps/public-surface/src"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node dist/apps/public-surface/main.js"
      }
    }
  },
  "tags": []
}
