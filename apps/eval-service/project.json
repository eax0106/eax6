{
  "name": "eval-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/eval-service/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv sync --frozen",
        "cwd": "apps/eval-service"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "UVICORN_PORT=${EVAL_SERVICE_PORT:-8003} uv run uvicorn src.main:app",
        "cwd": "apps/eval-service"
      }
    },
    "serve-grpc": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python -m src.grpc_server",
        "cwd": "apps/eval-service"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff check .",
        "cwd": "apps/eval-service"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run mypy .",
        "cwd": "apps/eval-service"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest",
        "cwd": "apps/eval-service"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run alembic upgrade head",
        "cwd": "apps/eval-service"
      }
    },
    "migrate-rollback": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run alembic downgrade -1",
        "cwd": "apps/eval-service"
      }
    },
    "promotion-gate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python -m src.promotion_gate $PROMOTION_EVIDENCE_PATH",
        "cwd": "apps/eval-service"
      }
    }
  },
  "tags": []
}
