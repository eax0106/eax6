DATABASE_URL=postgres://platform_api:platform_api_local@localhost:5432/platform_db
MARKETPLACE_DATABASE_URL=postgres://platform_api:platform_api_local@localhost:5432/marketplace_db
MARKETPLACE_OBJECT_STORAGE_PROVIDER=mock
REGISTRY_SCAN_PROVIDER=mock
ENGINE_BASE_URL=http://localhost:3100
ADS_CORE_BASE_URL=http://localhost:8000
COST_LEDGER_BASE_URL=http://localhost:3110
EVAL_FACADE_TOKEN_REF=env:EVAL_FACADE_TOKEN
DEPLOYMENT_ADMIN_SERVICE_TOKEN_REF=env:DEPLOYMENT_ADMIN_SERVICE_TOKEN
CONNECTION_REGISTRY_SERVICE_TOKEN_REF=env:CONNECTION_REGISTRY_SERVICE_TOKEN
ENGINE_M2M_TOKEN_URL=https://tenant.auth0.com/oauth/token
ENGINE_M2M_AUDIENCE=https://engine.alter.local
ENGINE_M2M_CLIENT_ID=platform-api
ENGINE_M2M_CLIENT_SECRET_REF=env:ENGINE_M2M_CLIENT_SECRET
ENGINE_REQUEST_TIMEOUT_MS=5000
IDEMPOTENCY_TTL_SECONDS=86400
IDENTITY_PROVIDER=mock
# Set IDENTITY_PROVIDER=google and provide these to use real Google OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET_REF=env:GOOGLE_CLIENT_SECRET
# Dedicated expiry-only connection. Provision platform_retention separately;
# do not point this at the normal app or migration identity.
PLATFORM_RETENTION_DATABASE_URL=postgres://platform_retention:<retention-password>@localhost:5432/platform_db
