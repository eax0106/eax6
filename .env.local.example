# Copy to .env.local, replace every angle-bracket placeholder, never commit .env.local.

# Database passwords. All five are required by docker-compose.yml with no
# default -- compose refuses to start if any is unset.
#
# Only four containers run, but they host more logical databases than that:
# infrastructure/local/engine-db-init.sh creates audit_db, orchestration_db,
# intelligence_db, cost_db and eval_db inside the single engine-db container
# on 5433. ENGINE_DB_ADMIN_PASSWORD is the superuser for that cluster; the
# per-service passwords below are for the roles that own those databases.
PLATFORM_DB_PASSWORD=<generate-local-platform-password>
PLATFORM_RETENTION_DB_PASSWORD=<generate-local-retention-password>
ENGINE_DB_ADMIN_PASSWORD=<generate-local-admin-password>
AUDIT_DB_PASSWORD=<generate-local-audit-password>
AUDIT_RETENTION_DB_PASSWORD=<generate-local-audit-retention-password>
INTELLIGENCE_DB_PASSWORD=<generate-local-intelligence-password>
COST_DB_PASSWORD=<generate-local-cost-password>

# Dependency stack host ports (docker-compose.yml). Every host port the
# compose file binds is parameterised here with the committed value as the
# default, so a second checkout of this project on one machine can override
# them and coexist with a sibling stack holding the defaults. Setting none
# of them changes nothing. See scripts/bootstrap-env-local.sh, which carries
# these through into .env.local.
PLATFORM_DB_PORT=${PLATFORM_DB_PORT:-5432}
ENGINE_DB_PORT=${ENGINE_DB_PORT:-5433}
ADS_DB_PORT=${ADS_DB_PORT:-5434}
COST_DB_PORT=${COST_DB_PORT:-5435}
REDIS_PORT=${REDIS_PORT:-6379}
LOCALSTACK_PORT=${LOCALSTACK_PORT:-4566}
TEMPORAL_PORT=${TEMPORAL_PORT:-7233}
TEMPORAL_UI_PORT=${TEMPORAL_UI_PORT:-8233}
TEMPO_PORT=${TEMPO_PORT:-3200}
TEMPO_OTLP_GRPC_PORT=${TEMPO_OTLP_GRPC_PORT:-4317}
TEMPO_OTLP_HTTP_PORT=${TEMPO_OTLP_HTTP_PORT:-4318}
GRAFANA_PORT=${GRAFANA_PORT:-3300}
PRESIDIO_ANALYZER_PORT=${PRESIDIO_ANALYZER_PORT:-5001}
PRESIDIO_ANONYMIZER_PORT=${PRESIDIO_ANONYMIZER_PORT:-5002}

ALTER_ENV=local
ALTER_REGION=ap-south-1
ACTOR_TOKEN_SIGNING_KEY_REF=/alter/local/platform-api/system/actor-token-signing-key

# ALTER_SERVICE_NAME is deliberately absent. Every service validates it
# against its own name, so a single shared file can only ever satisfy one of
# them; each service now defaults to its own name and still rejects a wrong
# one when it is set explicitly, as deployments do.

# RUNTIME_MODE answers real versus mock. ALTER_CONFIG_SOURCE answers where
# real configuration lives; both names have one meaning for every service.
RUNTIME_MODE=mock
ALTER_CONFIG_SOURCE=local-file

# Per-service HTTP ports and gRPC bind addresses. PORT, GRPC_BIND_ADDRESS and
# DATABASE_SECRET_REF still work as shared fallbacks, but one file cannot hold
# four different values for them, so each service reads its own name first.
AUDIT_PORT=3021
AUDIT_GRPC_BIND_ADDRESS=0.0.0.0:50068
AUDIT_ARCHIVE_BUCKET_PARAM=/alter/local/audit/archive-bucket
AUDIT_DATABASE_SECRET_REF=alter/local/audit-service/db-password
AUDIT_RETENTION_DATABASE_SECRET_REF=alter/local/audit-service/retention-database
AUDIT_CHAIN_SIGNING_KEY_REF=alter/local/audit-service/chain-signing-key
ADS_DELETION_BASE_URL=http://127.0.0.1:3003
ORCHESTRATION_DELETION_BASE_URL=http://127.0.0.1:3010
PLATFORM_API_DELETION_BASE_URL=http://127.0.0.1:3020
COST_DELETION_BASE_URL=http://127.0.0.1:3022
INTELLIGENCE_DELETION_BASE_URL=http://127.0.0.1:8000
MEMORY_DELETION_BASE_URL=http://127.0.0.1:8002
DELETION_SERVICE_TOKEN_REF=alter/local/audit-service/deletion-service-token
DELETION_PSEUDONYM_KEY_REF=alter/local/audit-service/deletion-pseudonym-key

COST_PORT=3022
COST_GRPC_BIND_ADDRESS=0.0.0.0:50069
COST_DATABASE_SECRET_REF=/alter/local/cost-ledger-service/database-credentials
COST_PSEUDONYM_KEY_REF=/alter/local/cost-ledger-service/pseudonym-key

MODEL_GATEWAY_PORT=3023
MODEL_GATEWAY_GRPC_BIND_ADDRESS=0.0.0.0:50051
# Keep mock by default. Set titan to exercise real capability discrimination
# while all other local model-gateway providers remain mocks.
MODEL_GATEWAY_EMBEDDING_PROVIDER=mock

TOOL_GATEWAY_PORT=3024
TOOL_GATEWAY_GRPC_BIND_ADDRESS=0.0.0.0:50053
# Where tool-gateway writes its audit entries: audit-service's gRPC bind
# (AUDIT_GRPC_BIND_ADDRESS). Required under RUNTIME_MODE=real.
AUDIT_SERVICE_GRPC_ADDRESS=127.0.0.1:50068

# Vendor references for the AppConfig path (task 1.6). RUNTIME_MODE=mock
# does not read any of these. Only committed once the real secret exists, and
# scripts/check-reference-resolution.sh fails if one does not.
TAVILY_API_KEY_SECRET_REF=/alter/local/tool-gateway/tavily-api-key
BROWSERBASE_API_KEY_REF=alter/local/tool-gateway/browserbase-api-key
# Not a secret reference -- read as a literal value, not resolved against AWS.
# check-reference-resolution.sh does not (and cannot) verify this one. Not
# sensitive -- Browserbase project IDs are meant to be used client-side to
# create sessions, same as the dashboard shows it in plain text.
BROWSERBASE_PROJECT_ID=c214bf9e-3b19-4e5d-8aa4-c55472ce4669
E2B_API_KEY_REF=alter/local/sandbox-service/e2b-api-key

# AppConfig identifiers per service -- identifiers, not secrets. The services
# read unscoped APPCONFIG_*; scripts/run-service-aws.sh maps the scoped set for
# the one service it starts. sandbox-service reads the tool-gateway policy:
# the policy document is engine-wide (model-alias bindings plus tool
# permissions), so a second copy could only drift. provisioning-service reads
# no AppConfig. Boot any of them against real AWS with:
#   bash scripts/run-service-aws.sh <service> --check
MODEL_GATEWAY_APPCONFIG_APPLICATION_ID=j5k0glc
MODEL_GATEWAY_APPCONFIG_ENVIRONMENT_ID=uhmphk3
MODEL_GATEWAY_APPCONFIG_CONFIGURATION_PROFILE_ID=08mu0r3
TOOL_GATEWAY_APPCONFIG_APPLICATION_ID=uxyyu5r
TOOL_GATEWAY_APPCONFIG_ENVIRONMENT_ID=vlkcayi
TOOL_GATEWAY_APPCONFIG_CONFIGURATION_PROFILE_ID=xgmzcgm
SANDBOX_SERVICE_APPCONFIG_APPLICATION_ID=uxyyu5r
SANDBOX_SERVICE_APPCONFIG_ENVIRONMENT_ID=vlkcayi
SANDBOX_SERVICE_APPCONFIG_CONFIGURATION_PROFILE_ID=xgmzcgm

ORCHESTRATION_PORT=3010
ENGINE_BASE_URL=http://127.0.0.1:3010

# Application HTTP ports. Service-specific names keep two native checkouts
# from sharing PORT/UVICORN_PORT and make health probes follow the same values.
ADS_CORE_PORT=8010
BACKGROUND_WORKERS_PORT=3011
PLATFORM_API_PORT=3020
SANDBOX_SERVICE_PORT=3025
PROVISIONING_SERVICE_PORT=3026
INTELLIGENCE_SERVICE_PORT=8000
VERIFICATION_SERVICE_PORT=8001
MEMORY_SERVICE_PORT=8002
EVAL_SERVICE_PORT=8003
EVAL_HISTORY_BASE_URL=http://127.0.0.1:8003
PLATFORM_WEB_PORT=5173
MOCK_AUTH0_PORT=4999

# Do not set AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY here. LocalStack accepts
# unsigned local calls, and leaving these absent lets real-AWS commands use the
# operator's ~/.aws profile instead of being overwritten by test credentials.
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://127.0.0.1:4566
# Bedrock bypasses LocalStack; LocalStack has no Bedrock Runtime service.
AWS_ENDPOINT_URL_BEDROCK_RUNTIME=https://bedrock-runtime.ap-south-1.amazonaws.com
AWS_EC2_METADATA_DISABLED=true

# Session Gateway replay protection / Blackboard cache. docker compose exposes
# this local service on loopback; no manually started native Redis is needed.
REDIS_ENDPOINT=redis://127.0.0.1:6379

# ADS Core local database uses its documented development-only credentials:
# ads_core/ads_core_local and ads_deletion/ads_deletion_local on port 5434.
# Keep the raw service token out of this file. Export its SHA-256 before
# starting ADS Core, as shown in docs/local-dev.md.
# platform-api presents that same token on its knowledge calls to ADS Core.
ADS_CORE_SERVICE_TOKEN_REF=env:INTERNAL_SERVICE_TOKEN

# Policy Store cross-service calls (memory-service's /memory/active-policy,
# read by intelligence-service's routing_weights lookup and
# verification-service's quality_thresholds lookup). Same shared-secret
# mechanism as ADS Core above -- memory-service validates the SHA-256 of
# INTERNAL_SERVICE_TOKEN against its own INTERNAL_SERVICE_TOKEN_SHA256.
# Keep the raw token out of this file; export both sides consistently
# before starting these services, as shown in docs/local-dev.md.
MEMORY_SERVICE_BASE_URL=http://127.0.0.1:${MEMORY_SERVICE_PORT:-8002}
# The sibling services memory-service itself calls. Its own defaults point at
# ports 3000 and 8000, which this stack does not use: orchestration-service's
# HTTP surface is on PORT below (3010) because 3000 is usually platform-web, and
# 8000 is the uvicorn default that intelligence-service and verification-service
# would both otherwise claim.
ORCHESTRATION_SERVICE_BASE_URL=http://127.0.0.1:3010
INTELLIGENCE_SERVICE_BASE_URL=http://127.0.0.1:${INTELLIGENCE_SERVICE_PORT:-8000}

# platform-api's identity and email providers both default to "mock" in
# code when unset (apps/platform-api/src/identity/identity.module.ts,
# packages/adapters/src/ses/resolve-email-provider.ts) -- nothing to set
# here for local dev. Real values: IDENTITY_PROVIDER=auth0|google (needs
# AUTH0_DOMAIN/AUTH0_CLIENT_ID or GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET_REF),
# EMAIL_PROVIDER=ses (needs SES_FROM_ADDRESS/SES_CREDENTIALS_SECRET_REF; an
# optional SES_CONFIGURATION_SET_NAME enables delivery/bounce read-back).
# Both are fatal instead of silently mocking when NODE_ENV=production.
# IDENTITY_PROVIDER=mock
# EMAIL_PROVIDER=mock

# Media providers (packages/adapters/src/aws/resolve-media-providers.ts)
# all default to "mock" in code when unset -- nothing to set here for
# local dev; image/tts/stt calls round-trip against in-memory mocks.
# Real values: MEDIA_OBJECT_STORAGE_PROVIDER=s3, IMAGE_GEN_PROVIDER=titan,
# TEXT_TO_SPEECH_PROVIDER=polly, SPEECH_TO_TEXT_PROVIDER=transcribe.
# MEDIA_BUCKET_NAME is required only once at least one of the 3 provider
# vars above is set to its real value. Every one of these is fatal
# instead of silently mocking when NODE_ENV=production.
# MEDIA_OBJECT_STORAGE_PROVIDER=mock
# IMAGE_GEN_PROVIDER=mock
# TEXT_TO_SPEECH_PROVIDER=mock
# SPEECH_TO_TEXT_PROVIDER=mock
# MEDIA_BUCKET_NAME=<required-only-when-a-real-provider-above-is-selected>

# --- Service-to-service tokens -------------------------------------------
# Required by the Python services. Each validates the SHA-256; callers send the
# raw token. Generate a pair with:
#   TOK=$(openssl rand -hex 32)
#   echo "INTERNAL_SERVICE_TOKEN=$TOK"
#   echo "INTERNAL_SERVICE_TOKEN_SHA256=$(printf %s "$TOK" | sha256sum | cut -d" " -f1)"
INTERNAL_SERVICE_TOKEN=<generate-32-byte-hex-token>
INTERNAL_SERVICE_TOKEN_SHA256=<sha256-of-the-token-above>
CONNECTION_REGISTRY_SERVICE_TOKEN=<generate-connection-registry-token>
CONNECTION_REGISTRY_SERVICE_TOKEN_REF=env:CONNECTION_REGISTRY_SERVICE_TOKEN
CONNECTION_REGISTRY_SERVICE_TOKEN_SHA256=<sha256-of-connection-registry-token>
BILLING_SYNC_SERVICE_TOKEN=<generate-billing-sync-token>
BILLING_SYNC_SERVICE_TOKEN_REF=env:BILLING_SYNC_SERVICE_TOKEN
BILLING_SYNC_SERVICE_TOKEN_SHA256=<sha256-of-billing-sync-token>

# ads-core deletion endpoint. Leave empty to run ads-core without deletion --
# router.py compares against this, so an empty value rejects every request.
DELETION_SERVICE_TOKEN=
DELETION_SERVICE_TOKEN_SHA256=

# --- Database URLs --------------------------------------------------------
# Services default to fixed development passwords (ads_core_local,
# intelligence_local, memory_local), but engine-db-init.sh creates the roles
# with the passwords above. Set these so services reach the roles that exist.
# Substitute the values you generated for the *_DB_PASSWORD entries.
DATABASE_URL=postgresql://platform_api:<PLATFORM_DB_PASSWORD>@localhost:${PLATFORM_DB_PORT:-5432}/platform_db
PLATFORM_RETENTION_DATABASE_URL=postgresql://platform_retention:<PLATFORM_RETENTION_DB_PASSWORD>@localhost:${PLATFORM_DB_PORT:-5432}/platform_db
MARKETPLACE_DATABASE_URL=postgresql://platform_api:<PLATFORM_DB_PASSWORD>@localhost:${PLATFORM_DB_PORT:-5432}/platform_db
# Staff plane (admin security queue, marketplace governance, KYC review): reads
# across tenants. Locally this is the container's superuser like the two above;
# on the EC2 host deploy/ec2/bootstrap.sh points the four at the platform_app
# and platform_operations roles (deploy/ec2/platform-db-roles.sql).
OPERATIONS_PLATFORM_DATABASE_URL=postgresql://platform_api:<PLATFORM_DB_PASSWORD>@localhost:${PLATFORM_DB_PORT:-5432}/platform_db
OPERATIONS_MARKETPLACE_DATABASE_URL=postgresql://platform_api:<PLATFORM_DB_PASSWORD>@localhost:${PLATFORM_DB_PORT:-5432}/platform_db
# The cross-tenant platform jobs (notification digests, connector health sweep)
# fail closed without these; same role as the staff plane.
NOTIFICATION_DIGEST_SYSTEM_DATABASE_URL=postgresql://platform_api:<PLATFORM_DB_PASSWORD>@localhost:${PLATFORM_DB_PORT:-5432}/platform_db
CONNECTOR_HEALTH_SWEEP_SYSTEM_DATABASE_URL=postgresql://platform_api:<PLATFORM_DB_PASSWORD>@localhost:${PLATFORM_DB_PORT:-5432}/platform_db
MARKETPLACE_SEARCH_CURSOR_SECRET=<generate-32-byte-hex-secret>
INTELLIGENCE_DB_URL=postgresql+asyncpg://intelligence_service:<INTELLIGENCE_DB_PASSWORD>@localhost:${ENGINE_DB_PORT:-5433}/intelligence_db
INTELLIGENCE_DB_URL_SYNC=postgresql+psycopg2://intelligence_service:<INTELLIGENCE_DB_PASSWORD>@localhost:${ENGINE_DB_PORT:-5433}/intelligence_db
POLICY_DB_URL_SYNC=postgresql+psycopg2://memory_service:<AUDIT_DB_PASSWORD>@localhost:${ENGINE_DB_PORT:-5433}/policy_db
# Highest tier agent auto-creation may mint for a capability nobody covers.
# A genuine capability gap is created at the tier the requirement asked for --
# no cheaper tier satisfies selection-binding's >= tier filter -- so without a
# ceiling any caller could cause a CEILING agent to exist by asking for one.
# Above this, the no-match is returned instead. FAST | STANDARD | ADVANCED |
# CEILING; defaults to STANDARD when unset (design log 31).
AGENT_AUTO_CREATION_MAX_TIER=STANDARD
# memory-service opens a second connection as policy_system_writer for the rows
# its RLS policies reserve to that identity -- every agent drift write, and every
# global-scope policy or memory write. Its own default for this carries no
# password, so leaving it unset fails authentication at call time rather than at
# boot. engine-db-init.sh gives the role AUDIT_DB_PASSWORD unless you set
# POLICY_SYSTEM_WRITER_PASSWORD.
POLICY_DB_SYSTEM_URL_SYNC=postgresql+psycopg2://policy_system_writer:<AUDIT_DB_PASSWORD>@localhost:${ENGINE_DB_PORT:-5433}/policy_db

# Direct migration URLs for the three services that otherwise migrate only on
# startup. Used by their drizzle.config.ts.
ORCHESTRATION_DATABASE_URL=postgresql://orchestration_service:<AUDIT_DB_PASSWORD>@localhost:${ENGINE_DB_PORT:-5433}/orchestration_db
AUDIT_DATABASE_URL=postgresql://audit_service:<AUDIT_DB_PASSWORD>@localhost:${ENGINE_DB_PORT:-5433}/audit_db
COST_DATABASE_URL=postgresql://cost_ledger_service:<COST_DB_PASSWORD>@localhost:${COST_DB_PORT:-5435}/cost_db

# --- Local M2M authentication --------------------------------------------
# ServiceAuthGuard validates a real Auth0 M2M JWT on every gRPC and internal
# HTTP surface. RUNTIME_MODE=mock does NOT cover this: model-gateway and
# friends throw "Session Gateway M2M configuration is incomplete" at boot
# without these, and reject every call with "Internal service credential is
# invalid" without a token.
#
# scripts/local-mock-auth0/server.js issues tokens the validator accepts.
# Start it first:  node scripts/local-mock-auth0/server.js &
AUTH0_DOMAIN=alterx-local-m2m.test
AUTH0_JWKS_URL=http://127.0.0.1:4999/.well-known/jwks.json
API_AUDIENCE=https://engine.alter.local

# The block above validates *incoming* calls. orchestration-service also
# makes *outbound* M2M calls as a client -- e.g. LlmTaskHandler's stream to
# model-gateway via ModelGatewayClient -- and that path goes through
# Auth0M2mTokenProvider (packages/auth/session-gateway), which reads a
# separate set of variables and throws "Missing required Auth0 M2M
# configuration: AUTH0_M2M_TOKEN_URL" at call time, not at boot, if they are
# absent. The same local-mock-auth0 server issues these too; any non-empty
# client id/secret is accepted locally.
#
# ads-core, intelligence-service, eval-service and memory-service read the
# same four names for their own outbound calls. Each service should have its
# own Auth0 application in a real deployment -- one shared client id here is a
# local convenience, not the deployed shape.
AUTH0_M2M_TOKEN_URL=http://127.0.0.1:4999/oauth/token
AUTH0_M2M_AUDIENCE=https://engine.alter.local
AUTH0_M2M_CLIENT_ID=local-dev-client
AUTH0_M2M_CLIENT_SECRET=local-dev-secret

# ---------------------------------------------------------------------------
# Engine service wiring
#
# The variables above bring up the dependency stack. These wire the services to
# it and to each other. Without them orchestration-service and background-workers
# refuse to boot -- `source .env.local` alone is not enough, despite what earlier
# revisions of docs/local-dev.md implied.
#
# Ports match the fixture in
# apps/orchestration-service/src/health/health.controller.spec.ts, which is the
# closest thing the repo has to a canonical local address map.
# ---------------------------------------------------------------------------

# Temporal and its task queues.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
PLATFORM_TEMPORAL_NAMESPACE=default
EXECUTOR_TASK_QUEUE=executor
CONVERSATION_LIFECYCLE_TASK_QUEUE=conversation-lifecycle
CONVERSATION_HISTORY_ROLLOVER_EVENT_COUNT=500
PLATFORM_JOBS_TASK_QUEUE=platform-jobs

# Production Temporal Cloud workers additionally require an API key plus an
# immutable build identity. Keep these unset for the local start-dev server.
# TEMPORAL_API_KEY is resolved from the deployment secret store.
# TEMPORAL_WORKER_BUILD_ID=<image digest or git commit>
# TEMPORAL_WORKER_DEPLOYMENT_NAME=alter-engine-workers
# PLATFORM_TEMPORAL_WORKER_DEPLOYMENT_NAME=alter-platform-workers
# TEMPORAL_MINIMUM_RETENTION_DAYS=7
# PLATFORM_TEMPORAL_MINIMUM_RETENTION_DAYS=7

# Where each service is reachable.
#
# Real service surfaces occupy 50050-50069. Every one is pinned here rather
# than left to a code default: ads-core and sandbox-service both defaulted to
# 50057 until they were separated, and because neither was written down the
# clash was invisible until someone put them on one host.
ADS_Q_GRPC_BIND_ADDRESS=0.0.0.0:50050
ADSQ_GRPC_TARGET=127.0.0.1:50050
MODEL_GATEWAY_ADDRESS=127.0.0.1:50051
# orchestration-service's compiler surface, bound per COMPILER_GRPC_BIND_ADDRESS.
COMPILER_GRPC_TARGET=127.0.0.1:50056
TOOL_GATEWAY_ADDRESS=127.0.0.1:50053
VERIFY_SERVICE_ADDRESS=127.0.0.1:50054
PROVISIONING_SERVICE_ADDRESS=127.0.0.1:50055
SANDBOX_SERVICE_ADDRESS=127.0.0.1:50057
MEMORY_SERVICE_ADDRESS=127.0.0.1:50060
MEMORY_SERVICE_AUTHORIZATION="Bearer local-dev-token"
EVAL_SERVICE_GRPC_TARGET=127.0.0.1:50062
BLACKBOARD_ADDRESS=127.0.0.1:50065
NODEEXEC_ADDRESS=127.0.0.1:50064

# recovery-environment.ts's CAPABILITY_RESOLVER_ADDRESS default is
# localhost:50062, which is EVAL_SERVICE_GRPC_TARGET above, not Capability
# Resolver. The real target is intelligence-service's
# capability_grpc_bind_address (apps/intelligence-service/src/config.py),
# default 0.0.0.0:50061. Used by the node executor's every capability
# lookup and agent-binding call, not just recovery, despite the name.
CAPABILITY_RESOLVER_ADDRESS=127.0.0.1:50061

# The gRPC surfaces orchestration-service binds. It hosts several in one
# process, so each needs its own port.
CONVERSATION_GRPC_BIND_ADDRESS=0.0.0.0:50052
COMPILER_GRPC_BIND_ADDRESS=0.0.0.0:50056
RECOVERY_GRPC_BIND_ADDRESS=0.0.0.0:50058
REGISTRY_GRPC_BIND_ADDRESS=0.0.0.0:50063
NODEEXEC_GRPC_BIND_ADDRESS=0.0.0.0:50064
BLACKBOARD_GRPC_BIND_ADDRESS=0.0.0.0:50065
DEPLOYCTL_GRPC_BIND_ADDRESS=0.0.0.0:50066
# artifact-content-environment.ts's own default (0.0.0.0:50061) collides
# with intelligence-service's capability_grpc_bind_address default above --
# two different processes both trying to bind :50061 on the same host. The
# default is now 50067 and no longer collides; this line is kept because
# deployments should still be explicit.
ARTIFACT_CONTENT_GRPC_BIND_ADDRESS=0.0.0.0:50067
# sandbox-service's client for that surface (orchestration-service). Required
# in both modes.
ARTIFACT_CONTENT_SERVICE_ADDRESS=127.0.0.1:50067

# orchestration-service's HTTP surface. 3000 is usually taken by platform-web.
# This is the shared PORT: orchestration-service is the one service that reads
# it directly. The four services above read their own scoped names first, so
# this no longer decides their ports too.
PORT=3010

# orchestration-service's database role. engine-db-init.sh creates it from
# ORCHESTRATION_DB_PASSWORD; the role carries BYPASSRLS, so it must not be blank.
ORCHESTRATION_DB_PASSWORD=replace-me-with-a-random-value
ORCHESTRATION_DATABASE_HOST=127.0.0.1
ORCHESTRATION_DATABASE_PORT=${ENGINE_DB_PORT:-5433}
ORCHESTRATION_DATABASE_NAME=orchestration_db
ORCHESTRATION_DATABASE_USER=orchestration_service
ORCHESTRATION_DATABASE_URL=postgresql://orchestration_service:replace-me-with-a-random-value@127.0.0.1:${ENGINE_DB_PORT:-5433}/orchestration_db
DELETION_DATABASE_USER=orchestration_deletion

# orchestration-service names this one AUTH0_API_AUDIENCE; sandbox-service and
# model-gateway read the same value from API_AUDIENCE above. Both are required.
AUTH0_API_AUDIENCE=https://engine.alter.local
# Actor ("delegation") tokens are minted by platform-api's identity broker, not
# by Auth0, and it signs them with ACTOR_TOKEN_SIGNING_KEY_REF and publishes the
# matching public key at its own /.well-known/actor-jwks.json. The issuer and
# audience below are the constants platform-api actually stamps
# (apps/platform-api/src/identity-broker/identity-broker.service.ts); the engine
# rejects the token with AUTH_INVALID_ACTOR_TOKEN if any of the three disagree.
# Pointing the JWKS URL at the mock Auth0 server cannot work -- that server mints
# its own ephemeral keypair for M2M tokens and never sees the actor-token key.
ACTOR_TOKEN_ISSUER=alter-platform-api.identity-broker
ACTOR_TOKEN_AUDIENCE=alter-engine
ACTOR_TOKEN_JWKS_URL=http://127.0.0.1:${PLATFORM_API_PORT:-3020}/.well-known/actor-jwks.json

# Service tokens are compared as SHA-256 hex. Any 64 hex characters work locally.
EVAL_FACADE_TOKEN_SHA256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
DELETION_SERVICE_TOKEN_SHA256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
DEPLOYMENT_ADMIN_SERVICE_TOKEN_SHA256=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc

# The artifacts bucket parameter lives at the real-AWS path-style name. The
# localstack-init hook seeds the same path-style name into LocalStack, which
# accepts it (verified on LocalStack 4.14.0). orchestration-service reads this
# eagerly at boot, so the parameter must exist wherever it resolves.
ALTER_ARTIFACTS_BUCKET_PARAM=/alter/local/orchestration/artifacts-bucket
EVENTBRIDGE_BUS_NAME=alter-local

CONVERSATION_IDLE_TIMEOUT_SECONDS=900
WEBHOOK_PUBLIC_BASE_URL=http://127.0.0.1:3010
WHATSAPP_APP_SECRET=local-app-secret
WHATSAPP_VERIFY_TOKEN=local-verify-token
WHATSAPP_TIMESTAMP_SKEW_SECONDS=300
WHATSAPP_TENANT_ID=00000000-0000-7000-8000-000000000001
WHATSAPP_WORKSPACE_ID=00000000-0000-7000-8000-000000000011

# --- eval-service -------------------------------------------------------
# Every address below is a target eval-service dials. Some are the production
# services; the rest are eval-only helper servers that production's own
# entrypoint cannot stand in for, started by scripts/run-eval-helpers.sh on the
# fixed ports named here. docs/runbooks/eval-golden-sets.md says which is which
# and why, address by address -- read it before changing one of these.
VERIFICATION_GRPC_TARGET=127.0.0.1:50054
VERIFICATION_SEVERITY_GRPC_TARGET=127.0.0.1:50054
MODEL_GATEWAY_GRPC_TARGET=127.0.0.1:50051
TOOLGW_GRPC_TARGET=127.0.0.1:50053
TOOL_CONSUME_GRPC_TARGET=127.0.0.1:50072
RECOVERY_GRPC_TARGET=127.0.0.1:50071
AUDIT_GRPC_TARGET=127.0.0.1:50068
# ConversationService, which is what the intent evaluation classifies against.
INTENT_GRPC_TARGET=127.0.0.1:50052
# ads-core's eval gRPC server, NOT its production AdsqService on 50070. That
# server seeds the retrieval golden set's own 12-document corpus and its scope
# on startup, and embeds deterministically in-process rather than through a
# live provider. Production has neither the corpus nor the scope, so aiming
# these at it scores zero -- refusing an unknown scope is correct tenant
# isolation, not a defect.
RETRIEVAL_GRPC_TARGET=127.0.0.1:50073
TENANT_ISOLATION_RETRIEVAL_GRPC_TARGET=127.0.0.1:50073

PLANNER_BASE_URL=http://127.0.0.1:${INTELLIGENCE_SERVICE_PORT:-8000}
AGENT_BINDING_BASE_URL=http://127.0.0.1:${INTELLIGENCE_SERVICE_PORT:-8000}
# Served by orchestration's eval_security_http_server, not by ads-core on 3003:
# no production route answers /classify-injection or /check-ssrf.
SECURITY_EVAL_BASE_URL=http://127.0.0.1:3005
UPLOAD_EVAL_BASE_URL=http://127.0.0.1:3003
INGESTION_BASE_URL=http://127.0.0.1:3003
POLICY_BASE_URL=http://127.0.0.1:${MEMORY_SERVICE_PORT:-8002}
MEMORY_DRIFT_BASE_URL=http://127.0.0.1:${MEMORY_SERVICE_PORT:-8002}
CREDENTIAL_BASE_URL=http://127.0.0.1:3012
TRIGGER_REGISTRY_BASE_URL=http://127.0.0.1:3011
RUN_VISIBILITY_BASE_URL=http://127.0.0.1:3006
WORKFLOW_BASE_URL=http://127.0.0.1:3007
PROJECT_BASE_URL=http://127.0.0.1:3008
# The idempotency evaluation calls the same service as two different tenants.
IDEMPOTENCY_TENANT_A_BASE_URL=http://127.0.0.1:3013
IDEMPOTENCY_TENANT_B_BASE_URL=http://127.0.0.1:3014

# These are handed to psycopg2.connect(), so they are plain DSNs rather than
# the SQLAlchemy "+driver" URLs the owning services use. EVAL_ADS_DB_URL and
# EVAL_INTELLIGENCE_DB_URL are scoped because ADS_DB_URL and
# INTELLIGENCE_DB_URL already belong to ads-core and intelligence-service in
# an async form psycopg2 cannot parse.
ORCHESTRATION_DB_URL=postgresql://orchestration_service:<ORCHESTRATION_DB_PASSWORD>@127.0.0.1:${ENGINE_DB_PORT:-5433}/orchestration_db
PLATFORM_DB_URL=postgresql://platform_api:<PLATFORM_DB_PASSWORD>@127.0.0.1:${PLATFORM_DB_PORT:-5432}/platform_db
POLICY_DB_URL=postgresql://memory_service:<MEMORY_DB_PASSWORD>@127.0.0.1:${ENGINE_DB_PORT:-5433}/policy_db
EVAL_ADS_DB_URL=postgresql://ads_core:<ADS_DB_PASSWORD>@127.0.0.1:${ADS_DB_PORT:-5434}/ads_db
EVAL_INTELLIGENCE_DB_URL=postgresql://intelligence_service:<INTELLIGENCE_DB_PASSWORD>@127.0.0.1:${ENGINE_DB_PORT:-5433}/intelligence_db

# engine-db-init.sh creates the eval_service role with EVAL_DB_PASSWORD,
# which defaults to AUDIT_DB_PASSWORD. The DSN compiled into config.py
# carries a placeholder password that role never has, so this must be set
# for migrations or the service to connect.
EVAL_DB_URL_SYNC=postgresql+psycopg2://eval_service:<AUDIT_DB_PASSWORD>@127.0.0.1:${ENGINE_DB_PORT:-5433}/eval_db
# --- model-gateway against real AWS ------------------------------------
# Only model-gateway reads these. The rest of the stack stays on LocalStack
# and on RUNTIME_MODE=mock; scripts/run-service-aws.sh is what flips one
# service over, because AWS_ENDPOINT_URL is global to the SDK and cannot be
# true and false in the same file. Its AppConfig identifiers are above.

# Secret *references*, never values. Anthropic and OpenAI are optional
# direct-API failovers behind Bedrock: set ANTHROPIC_API_KEY_SECRET_REF or
# OPENAI_API_KEY_SECRET_REF only once that secret exists. Unset means no such
# failover. The platform admin token is NOT optional -- resolveAdminServiceToken
# uses getSecret.
PLATFORM_ADMIN_SERVICE_TOKEN_SECRET_REF=/alter/local/model-gateway/platform-admin-service-token

# Redaction and cache, served by the local compose stack either way.
PRESIDIO_ANALYZER_URL=http://127.0.0.1:5001
PRESIDIO_ANONYMIZER_URL=http://127.0.0.1:5002
CACHE_REDIS_HOST=127.0.0.1
CACHE_REDIS_PORT=6379

# PROVIDER_CONTROL_PARAMETER_NAME and MODEL_POLICY_OVERRIDE_PARAMETER_NAME are
# deliberately unset: they default to /alter/<ALTER_ENV>/model-gateway/... ,
# which already sits inside the /alter/* prefix an IAM policy would scope to.
# Neither parameter needs to exist up front -- model-gateway creates the first
# on its first failover, and the second only when an operator overrides the
# deployed AppConfig baseline.

# Override to use a named profile from ~/.aws/credentials; unset uses the
# default credential chain.
# ALTER_AWS_PROFILE=alter

# --- Staff sign-in for the admin console (task B1.0) --------------------------
# Staff authenticate against a dedicated Auth0 tenant, never the customer one.
# Unset means the admin console answers "staff sign-in is not configured" in
# live mode. Needs: a staff tenant, a Single Page Application (PKCE) whose
# allowed callback includes <origin>/staff/callback, and each staff member
# added to platform_db.staff_users with their Auth0 subject.
# AUTH0_STAFF_DOMAIN=<staff-tenant.region.auth0.com>
# AUTH0_STAFF_CLIENT_ID=<staff SPA client id>

# D16 hosted forms (optional separate public-surface process). Generate both
# secret values locally; the Turnstile secret itself stays in Secrets Manager.
PUBLIC_SURFACE_DB_PASSWORD=replace-me-with-a-random-value
# PUBLIC_FORM_TOKEN_KEY=replace-me-with-64-random-hex-characters
# PUBLIC_FORM_BASE_URL=http://127.0.0.1:3021
PUBLIC_FORM_TURNSTILE_SITE_KEY=replace-me-with-turnstile-site-key
PUBLIC_FORM_TURNSTILE_SECRET_REF=/alter/local/public-surface/turnstile-secret
PUBLIC_SURFACE_DATABASE_AUTHENTICATION=static
# PUBLIC_SURFACE_DATABASE_URL=postgresql://public_surface:<PUBLIC_SURFACE_DB_PASSWORD>@127.0.0.1:${ENGINE_DB_PORT:-5433}/orchestration_db
PUBLIC_SURFACE_REDIS_URL=${REDIS_ENDPOINT:-redis://127.0.0.1:6379}
PUBLIC_SURFACE_PORT=3021
PUBLIC_SURFACE_TRUST_PROXY=none
