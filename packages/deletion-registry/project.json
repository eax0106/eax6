{
  "name": "deletion-registry",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/deletion-registry/src",
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
